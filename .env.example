# PostgreSQL is the intended production database.
# Example: postgresql+psycopg://postgres:postgres@localhost:5432/postgres_api
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres_api
APP_NAME=postgres_api
APP_VERSION=0.1.0
# Comma-separated explicit http(s) frontend origins allowed to call this API from browsers.
# Wildcards (*), null/file origins, and paths/query strings/fragments are not allowed.
# Example: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=
